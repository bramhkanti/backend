# Copy to apps/backend/.env. Never commit the real file.
NODE_ENV=development
MEDUSA_BACKEND_URL=http://localhost:9000

# Medusa running on the host -> Docker services via published ports.
# If Medusa itself runs in Docker on the same compose network, use
#   postgres://USER:PASS@postgres:5432/DB  and  redis://redis:6379
DATABASE_URL=postgres://bramhkanti:change-me@localhost:5442/bramhkanti_medusa
DB_NAME=bramhkanti_medusa
REDIS_URL=redis://localhost:6389

# Comma-separated origins. Add the storefront's real domains in production,
# e.g. https://bramhkanti.com,https://www.bramhkanti.com
STORE_CORS=http://localhost:3000,http://localhost:8000
ADMIN_CORS=http://localhost:5173,http://localhost:9000
AUTH_CORS=http://localhost:3000,http://localhost:8000,http://localhost:5173,http://localhost:9000

# Generate each with: openssl rand -hex 32  (production refuses weak values)
JWT_SECRET=
COOKIE_SECRET=
AUTH_MFA_ENCRYPTION_KEY=

MEDUSA_ADMIN_ONBOARDING_TYPE=default
LOG_LEVEL=info
# shared (default) | server | worker
MEDUSA_WORKER_MODE=shared
DISABLE_MEDUSA_ADMIN=false

# Product image storage. Leave S3_BUCKET empty to store uploads on local disk
# (development only). Any S3-compatible store works (AWS S3, Cloudflare R2...).
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_FILE_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Razorpay - TEST MODE keys (rzp_test_...) until go-live is approved.
# Provider is only registered when KEY_ID and KEY_SECRET are set.
# See PAYMENTS_SETUP.md
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Shiprocket API user (NOT the main Shiprocket login). Provider is only
# registered when EMAIL and PASSWORD are set. See SHIPPING_SETUP.md
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
# Pickup location NAME exactly as shown in Shiprocket > Settings > Pickup Address
SHIPROCKET_PICKUP_LOCATION=
SHIPROCKET_PICKUP_POSTCODE=
SHIPROCKET_WEBHOOK_TOKEN=
# Default packed-box size/weight used for every shipment (measure a real box)
SHIPROCKET_PACKAGE_LENGTH_CM=
SHIPROCKET_PACKAGE_BREADTH_CM=
SHIPROCKET_PACKAGE_HEIGHT_CM=
SHIPROCKET_PACKAGE_WEIGHT_KG=
