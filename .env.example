# Docker Compose variables for Postgres/Redis (copy to .env).
# Generate a strong password: openssl rand -hex 24
POSTGRES_USER=bramhkanti
POSTGRES_PASSWORD=change-me
POSTGRES_DB=bramhkanti_medusa
# Host ports (chosen to avoid 5432/5433/6379/6380 used by other local projects)
POSTGRES_HOST_PORT=5442
REDIS_HOST_PORT=6389
