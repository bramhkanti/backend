# Copy to deploy/.env on the server and fill in. Never commit deploy/.env.
# Generate secrets with:  openssl rand -hex 32

# --- Domains (DNS A records must point at this server) ---
SHOP_DOMAIN=bramhkanti.com
API_DOMAIN=api.bramhkanti.com
# Let's Encrypt expiry notices
ACME_EMAIL=brahmkantioffice@gmail.com

# --- Database (hex only: it goes inside a URL) ---
POSTGRES_USER=bramhkanti
POSTGRES_DB=bramhkanti_medusa
POSTGRES_PASSWORD=

# --- Medusa secrets (each at least 32 characters) ---
JWT_SECRET=
COOKIE_SECRET=
OTP_HASH_SECRET=
LOG_LEVEL=info
MEDUSA_WORKER_MODE=shared
DISABLE_MEDUSA_ADMIN=false

# --- Storefront ---
# Admin -> Settings -> Publishable API Keys (fill in after the first start, then rebuild the storefront)
MEDUSA_PUBLISHABLE_KEY=
# Shared secret for POST /api/revalidate (at least 32 characters)
REVALIDATE_SECRET=
NEXT_PUBLIC_BRAND_NAME=Bramhkanti
NEXT_PUBLIC_SUPPORT_EMAIL=
# Digits only with country code, e.g. 919876543210
NEXT_PUBLIC_WHATSAPP_NUMBER=
# 14 digits
NEXT_PUBLIC_FSSAI_LICENSE_NUMBER=
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- Mobile OTP login (see OTP_LOGIN.md) ---
# Until a real provider is set up, test mode lets OTP_TEST_CODE log in to ANY number.
# Set SMS_PROVIDER=msg91 and OTP_TEST_MODE=false before real customers use the site.
SMS_PROVIDER=test
OTP_TEST_MODE=true
OTP_TEST_CODE=123456
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# --- Product images ---
# Empty = stored on this server (docker volume medusa_static, included in backups).
# Fill all S3_* to use Cloudflare R2 / S3 instead.
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_FILE_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Payments / shipping: leave empty until set up (PAYMENTS_SETUP.md, SHIPPING_SETUP.md) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=
