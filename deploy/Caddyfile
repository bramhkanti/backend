{
	email {$ACME_EMAIL}
}

# Storefront
{$SHOP_DOMAIN} {
	encode zstd gzip

	# Content-hashed build files never change.
	@immutable path /_next/static/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	reverse_proxy storefront:3000
}

# www -> bare domain
www.{$SHOP_DOMAIN} {
	redir https://{$SHOP_DOMAIN}{uri} permanent
}

# Medusa API, admin dashboard (/app) and uploaded images (/static)
{$API_DOMAIN} {
	encode zstd gzip

	# Product image uploads from the admin.
	request_body {
		max_size 25MB
	}

	@uploads path /static/*
	header @uploads Cache-Control "public, max-age=604800"

	reverse_proxy medusa:9000
}
